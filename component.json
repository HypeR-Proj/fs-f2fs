{
  "SPDX-FileCopyrightText": "2026 roolrz",
  "SPDX-License-Identifier": "Apache-2.0",
  "version": 1,
  "name": "fs-f2fs",
  "kind": "service",
  "tests": [
    [
      "python3",
      "{component}/tests/check.py"
    ],
    [
      "make",
      "app-test",
      "APP_TEST_PACKAGE=hyper-fs-f2fs-system"
    ]
  ],
  "cargo": [
    {
      "manifest": "Cargo.toml",
      "domain": "system"
    }
  ],
  "build": {
    "requires": [
      "toolchain"
    ],
    "type": "native-rust"
  },
  "artifacts": [
    {
      "binary": "hyper-fs-f2fs-system",
      "staged": "fs-f2fs-system",
      "destination": "svc/fs-f2fs",
      "mode": "0755",
      "profiles": [
        "development"
      ],
      "rust_runtime": "std",
      "environment": "system",
      "manifest": "Cargo.toml",
      "enabled": true,
      "requires": [
        {
          "module": "fs-backend",
          "artifact": "fs-backend-system"
        }
      ]
    },
    {
      "source": "FUCHSIA-LICENSE",
      "destination": "share/licenses/fs-f2fs/FUCHSIA-LICENSE",
      "mode": "0644",
      "profiles": [
        "development"
      ],
      "environment": "system"
    },
    {
      "source": "FUCHSIA-PATENTS",
      "destination": "share/licenses/fs-f2fs/FUCHSIA-PATENTS",
      "mode": "0644",
      "profiles": [
        "development"
      ],
      "environment": "system"
    },
    {
      "source": "licenses/ext2-hash",
      "destination": "share/licenses/fs-f2fs/ext2-hash",
      "mode": "0644",
      "profiles": [
        "development"
      ],
      "environment": "system"
    },
    {
      "source": "licenses/safemath",
      "destination": "share/licenses/fs-f2fs/safemath",
      "mode": "0644",
      "profiles": [
        "development"
      ],
      "environment": "system"
    },
    {
      "source": "licenses/libcxx",
      "destination": "share/licenses/fs-f2fs/libcxx",
      "mode": "0644",
      "profiles": [
        "development"
      ],
      "environment": "system"
    },
    {
      "source": "licenses/musl-headers",
      "destination": "share/licenses/fs-f2fs/musl-headers",
      "mode": "0644",
      "profiles": [
        "development"
      ],
      "environment": "system"
    }
  ],
  "documentation": {
    "pages": [
      "README.md",
      "CONTRIBUTING.md",
      "SECURITY.md"
    ]
  }
}
